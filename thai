      "source": [
        "y, sr = librosa.load(sample_audio_path, sr=16000)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 🎯 ภารกิจที่ 1: เติมพารามิเตอร์ให้ตรงกับทฤษฎีการได้ยินของมนุษย์\n",
        "# ---------------------------------------------------------\n",
        "S = librosa.feature.melspectrogram(y=y, sr=sr, n_mels=64, fmax=8000)\n",
